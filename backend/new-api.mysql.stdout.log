		MAX(created_at) AS latest_created_at
	FROM logs
	WHERE type IN (2, 5) AND ((channel_id = 27 AND model_name = 'gpt-5.5' AND `group` = 'default') OR (channel_id = 29 AND model_name = 'gpt-5.6-luna' AND `group` = 'default') OR (channel_id = 29 AND model_name = 'gpt-5.4-mini' AND `group` = 'default') OR (channel_id = 29 AND model_name = 'gpt-5.4' AND `group` = 'default') OR (channel_id = 29 AND model_name = 'gpt-5.6-terra' AND `group` = 'default'))
	GROUP BY channel_id, model_name, `group`
) AS latest_requests
	ON l.channel_id = latest_requests.latest_channel_id
	AND l.model_name = latest_requests.latest_model_name
	AND l.`group` = latest_requests.latest_group
	AND l.created_at = latest_requests.latest_created_at
WHERE l.type IN (2, 5)
ORDER BY l.created_at DESC, l.id DESC, l.request_id DESC
